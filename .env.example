# ================================================================
# Eventora API — PRODUCTION Environment Variables
# Domain: https://eventora.heavenwebtechnologies.com
# ================================================================
# HOW TO USE:
#   On your server / VPS / cPanel / Railway / Render / DigitalOcean:
#   Copy every KEY=VALUE below into your hosting panel's
#   "Environment Variables" section  OR  into the .env file on server.
#
#   ⚠️  NEVER commit real values to GitHub.
#   ⚠️  .env is already in .gitignore — keep it safe.
# ================================================================

# ────────────────────────────────────────────────────────────────
# SERVER
# ────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
# If behind a reverse proxy (Nginx / Apache / cPanel), PORT can stay 5000.
# The proxy forwards public 80/443 → localhost:5000

# ────────────────────────────────────────────────────────────────
# MySQL DATABASE
# ────────────────────────────────────────────────────────────────
DB_HOST=localhost
# Use 127.0.0.1 if 'localhost' causes socket issues
DB_PORT=3306
DB_NAME=eventora
DB_USER=eventora_user
# ⚠️  Set a STRONG password — min 20 chars, mixed characters
DB_PASS=CHANGE_THIS_TO_YOUR_STRONG_DB_PASSWORD

# ────────────────────────────────────────────────────────────────
# JWT SECURITY
# ────────────────────────────────────────────────────────────────
# ⚠️  Generate your own with:
#     node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ⚠️  NEVER reuse the development secret in production
# ⚠️  NEVER share this value publicly
JWT_SECRET=GENERATE_AND_PASTE_YOUR_OWN_SECRET_HERE
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ────────────────────────────────────────────────────────────────
# DOMAIN & CORS
# ────────────────────────────────────────────────────────────────
PRODUCTION_DOMAIN=https://eventora.heavenwebtechnologies.com

# Add all frontend origins that will call this API (comma-separated, no spaces)
# If your frontend is on the same domain, only list that domain.
ALLOWED_ORIGINS=https://eventora.heavenwebtechnologies.com

# ────────────────────────────────────────────────────────────────
# RATE LIMITING
# ────────────────────────────────────────────────────────────────
# 15 minutes window (in milliseconds)
RATE_LIMIT_WINDOW_MS=900000
# Max requests per window per IP (general API)
RATE_LIMIT_MAX=100
# Max auth attempts per window per IP (login/register)
AUTH_RATE_LIMIT_MAX=10

# ────────────────────────────────────────────────────────────────
# FILE UPLOADS
# ────────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=5
# Absolute path recommended in production
UPLOAD_PATH=./uploads

# ────────────────────────────────────────────────────────────────
# LOGGING
# ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
