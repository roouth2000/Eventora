# ========================================
# Eventora API - Environment Configuration
# ========================================
# Copy this file to .env and fill in real values

# Server
NODE_ENV=development
PORT=5000

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=eventora
DB_USER=eventora_user
DB_PASS=

# JWT (generate via: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Production Domain
PRODUCTION_DOMAIN=https://eventora.heavenwebtechnologies.com

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://eventora.heavenwebtechnologies.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# File Upload
MAX_FILE_SIZE_MB=5
UPLOAD_PATH=./uploads

# Logging
LOG_LEVEL=info

# TODO(security): Add OAuth provider credentials (Google, GitHub) for social login
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# TODO(security): Add MFA secret / TOTP issuer name
# MFA_ISSUER=Eventora
# TODO(security): Configure mTLS for DB connection in production
